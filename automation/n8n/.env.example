# Generate each secret independently; never commit the real .env file.
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
CTRL2PHONE_WEBHOOK_SECRET=replace-with-another-32-character-random-secret

# n8n uses this privileged key. It must never be copied to desktop/mobile code,
# logs, workflow output, screenshots, or Git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Used only by `npm run e2e`; this public key is never passed to workflows.
SUPABASE_ANON_KEY=sb_publishable_replace_me
CTRL2PHONE_WEBHOOK_URL=http://127.0.0.1:5678/webhook/ctrl2phone-action
CTRL2PHONE_E2E_TIMEOUT_MS=180000
# Optional: absolute path to a PNG used for live analysis. A built-in 1x1 PNG
# is used when omitted.
# CTRL2PHONE_E2E_IMAGE_PATH=C:\path\to\safe-test-image.png

N8N_HOST=127.0.0.1
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_USER_FOLDER=.n8n
N8N_PUBLIC_API_DISABLED=true
N8N_COMMUNITY_PACKAGES_ENABLED=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_SSRF_PROTECTION_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
GENERIC_TIMEZONE=Europe/Istanbul
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
